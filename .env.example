# Base de datos Postgres (ver README > "Despliegue" para Supabase/Render).
# En Supabase: botón "Connect" > pestaña "ORM" > Prisma. Te da las dos
# variables de abajo ya armadas con el pooler (soporta IPv4, a diferencia
# de la conexión "directa" que usa IPv6 por defecto).
DATABASE_URL="postgresql://usuario.proyecto:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario.proyecto:password@host.pooler.supabase.com:5432/postgres"

# Secreto para firmar las sesiones (JWT). Generar uno propio y único:
#   openssl rand -base64 48
SESSION_SECRET="cambia-este-valor-por-uno-generado-con-openssl-rand--nunca-uses-este-en-produccion"

# Nombre de cookie de sesión del panel admin (opcional)
SESSION_COOKIE_NAME="exafrutos_session"

# Nombre de cookie de sesión de cuentas públicas de hinchas (opcional).
# Usa el mismo SESSION_SECRET de arriba, con un namespace distinto, así un
# JWT de hincha nunca es válido como sesión admin ni viceversa.
FAN_SESSION_COOKIE_NAME="exafrutos_fan_session"

# Subida de archivos (logos de equipo, PDF del reglamento) vía Supabase
# Storage — necesita un bucket público llamado "uploads" en el mismo
# proyecto de Supabase. Ver README > "Subida de archivos".
# Project Settings > API Keys > clave "secret" (o "service_role").
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SECRET_KEY="cambia-este-valor-por-tu-clave-secret-de-supabase"
