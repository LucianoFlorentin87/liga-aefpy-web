# Base de datos Postgres (ver README > "Despliegue" para Supabase/Render).
# En Supabase: botón "Connect" > pestaña "ORM" > Prisma. Te da las dos
# variables de abajo ya armadas con el pooler (soporta IPv4, a diferencia
# de la conexión "directa" que usa IPv6 por defecto).
DATABASE_URL="postgresql://usuario.proyecto:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario.proyecto:password@host.pooler.supabase.com:5432/postgres"

# Secreto para firmar las sesiones (JWT). Generar uno propio y único:
#   openssl rand -base64 48
SESSION_SECRET="cambia-este-valor-por-uno-generado-con-openssl-rand--nunca-uses-este-en-produccion"

# Nombre de cookie de sesión (opcional)
SESSION_COOKIE_NAME="exafrutos_session"
