// Prisma schema — Torneo Exa Frutos
//
// Proveedor por defecto: SQLite (archivo local), ideal para desarrollo y para
// entornos sin un servicio de base de datos externo. Para producción en
// Vercel/Netlify (funciones serverless con filesystem efímero) hay que migrar
// a una base persistente (Postgres). Ver README.md, sección "Base de datos en
// producción" para el paso a paso de la migración (es un cambio de 2 líneas:
// `provider` + `DATABASE_URL`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum RoleKey {
  SUPERADMIN
  ADMINISTRADOR
  CARGA_DATOS
}

model Role {
  id          Int    @id @default(autoincrement())
  key         RoleKey @unique
  name        String
  description String
  users       User[]

  @@map("roles")
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

model User {
  id            String     @id @default(cuid())
  firstName     String
  lastName      String
  email         String     @unique
  username      String     @unique
  passwordHash  String
  mustChangePassword Boolean @default(true)
  role          Role       @relation(fields: [roleId], references: [id])
  roleId        Int
  status        UserStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  activityLogs  ActivityLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Equipos y jugadores
// ---------------------------------------------------------------------------

enum TeamStatus {
  ACTIVO
  INACTIVO
}

model Team {
  id            String     @id @default(cuid())
  name          String     @unique
  shortName     String
  logoUrl       String?
  delegateName  String?
  delegatePhone String?
  status        TeamStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  players       Player[]
  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")
  goals         MatchGoal[]
  cards         MatchCard[]
  sanctions     Sanction[]
  participations MatchParticipation[]

  @@map("teams")
}

enum PlayerPosition {
  ARQUERO
  DEFENSOR
  MEDIOCAMPISTA
  DELANTERO
}

enum PlayerStatus {
  ACTIVO
  INACTIVO
}

model Player {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  jerseyNumber  Int
  position      PlayerPosition
  team          Team           @relation(fields: [teamId], references: [id])
  teamId        String
  birthDate     DateTime?
  status        PlayerStatus   @default(ACTIVO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  goals          MatchGoal[]
  cards          MatchCard[]
  sanctions      Sanction[]
  participations MatchParticipation[]

  @@map("players")
}

// ---------------------------------------------------------------------------
// Partidos
// ---------------------------------------------------------------------------

enum MatchStatus {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  SUSPENDIDO
  REPROGRAMADO
}

model Match {
  id           String      @id @default(cuid())
  matchday     Int
  date         DateTime
  time         String
  venue        String
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId   String
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId   String
  status       MatchStatus @default(PROGRAMADO)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  goals          MatchGoal[]
  cards          MatchCard[]
  participations MatchParticipation[]

  @@index([matchday])
  @@map("matches")
}

// Convocatoria: quiénes jugaron cada partido (para PJ y titularidades)
model MatchParticipation {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  isStarter Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
  @@map("match_participations")
}

model MatchGoal {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  minute    Int
  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@map("match_goals")
}

enum CardType {
  AMARILLA
  ROJA
}

model MatchCard {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  type      CardType
  minute    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@map("match_cards")
}

// ---------------------------------------------------------------------------
// Sanciones
// ---------------------------------------------------------------------------

enum SanctionStatus {
  ACTIVA
  CUMPLIDA
}

model Sanction {
  id            String         @id @default(cuid())
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  team          Team           @relation(fields: [teamId], references: [id])
  teamId        String
  reason        String
  matchesCount  Int
  startDate     DateTime
  endDate       DateTime?
  status        SanctionStatus @default(ACTIVA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("sanctions")
}

// ---------------------------------------------------------------------------
// Configuración del torneo y reglamento
// ---------------------------------------------------------------------------

model TournamentSettings {
  id                String   @id @default("settings")
  tournamentName    String   @default("Torneo Exa Frutos")
  standingsCriteria String   @default("PTS,DG,GF")
  rulesContent      String   @default("")
  updatedAt         DateTime @updatedAt

  @@map("tournament_settings")
}

// ---------------------------------------------------------------------------
// Actividad reciente (para el dashboard)
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id @default(cuid())
  message   String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())

  @@map("activity_log")
}
