// Prisma schema — Liga AEFPY
//
// Producción: Postgres (Supabase), vía el connection pooler (Supavisor):
// - DATABASE_URL: pooler en modo transacción (puerto 6543) — usado en runtime
//   por la app (Next.js hace muchas conexiones cortas, ideal para pooling).
// - DIRECT_URL: pooler en modo sesión (puerto 5432) — usado sólo por
//   `prisma migrate` para poder tomar locks de esquema, algo que el modo
//   transacción no soporta.
// Ambas salen de variables de entorno, nunca hardcodeadas acá. Ver
// README.md, sección "Despliegue" para el paso a paso (Render + Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum RoleKey {
  SUPERADMIN
  ADMINISTRADOR
  CARGA_DATOS
  DELEGADO
}

model Role {
  id          Int    @id @default(autoincrement())
  key         RoleKey @unique
  name        String
  description String
  users       User[]

  @@map("roles")
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

model User {
  id            String     @id @default(cuid())
  firstName     String
  lastName      String
  email         String     @unique
  username      String     @unique
  passwordHash  String
  mustChangePassword Boolean @default(true)
  role          Role       @relation(fields: [roleId], references: [id])
  roleId        Int
  // Sólo se usa (y es obligatorio) para el rol DELEGADO: el equipo al que
  // queda restringido su acceso (plantel, logo, datos de cancha).
  team          Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String?
  status        UserStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  activityLogs  ActivityLog[]
  // Sólo la usan los DELEGADO: pueden votar en las predicciones públicas
  // con su misma cuenta de staff, sin necesitar además una cuenta de hincha.
  predictions   Prediction[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Equipos y jugadores
// ---------------------------------------------------------------------------

enum TeamStatus {
  ACTIVO
  INACTIVO
}

model Team {
  id            String     @id @default(cuid())
  name          String     @unique
  shortName     String
  logoUrl       String?
  delegateName  String?
  delegatePhone String?
  // Correo de contacto del delegado. Es sólo un dato de contacto por ahora:
  // todavía no hay un flujo de "recuperar contraseña" automático por correo.
  delegateEmail String?
  // Cancha/estadio informativo del equipo (distinto de la cancha de cada
  // partido puntual, que puede variar). Lo puede editar el propio delegado.
  homeVenue     String?
  // Redes/streaming y aparecen como links en la ficha pública del equipo.
  instagramUrl  String?
  facebookUrl   String?
  youtubeUrl    String?
  twitchUrl     String?
  discordUrl    String?
  tiktokUrl     String?
  // Identificador del equipo/delegado en la plataforma donde se juega
  // (ej. PSN, Xbox Live, EA ID) — para verificar partidos online.
  gamertag      String?
  status        TeamStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  players       Player[]
  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")
  goals         MatchGoal[]
  cards         MatchCard[]
  sanctions     Sanction[]
  participations MatchParticipation[]
  pointAdjustments PointAdjustment[]
  delegateUsers User[]

  @@map("teams")
}

enum PlayerPosition {
  ARQUERO
  DEFENSOR
  MEDIOCAMPISTA
  DELANTERO
}

enum PlayerStatus {
  ACTIVO
  INACTIVO
}

model Player {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  jerseyNumber  Int
  position      PlayerPosition
  team          Team           @relation(fields: [teamId], references: [id])
  teamId        String
  birthDate     DateTime?
  status        PlayerStatus   @default(ACTIVO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  goals          MatchGoal[]
  cards          MatchCard[]
  sanctions      Sanction[]
  participations MatchParticipation[]

  @@map("players")
}

// ---------------------------------------------------------------------------
// Partidos
// ---------------------------------------------------------------------------

enum MatchStatus {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  SUSPENDIDO
  REPROGRAMADO
}

model Match {
  id           String      @id @default(cuid())
  matchday     Int
  date         DateTime
  time         String
  venue        String
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId   String
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId   String
  status       MatchStatus @default(PROGRAMADO)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  goals          MatchGoal[]
  cards          MatchCard[]
  participations MatchParticipation[]
  pointAdjustments PointAdjustment[]
  predictions    Prediction[]

  @@index([matchday])
  @@map("matches")
}

// Convocatoria: quiénes jugaron cada partido (para PJ y titularidades)
model MatchParticipation {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  isStarter Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
  @@map("match_participations")
}

model MatchGoal {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  minute    Int
  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@map("match_goals")
}

enum CardType {
  AMARILLA
  ROJA
}

model MatchCard {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String
  type      CardType
  minute    Int
  note      String?
  // Marca si esta amarilla ya "gatilló" una suspensión automática por
  // acumulación de 3 (Art. 8.2 del reglamento), para no volver a contarla.
  countedForSuspension Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@map("match_cards")
}

// ---------------------------------------------------------------------------
// Sanciones
// ---------------------------------------------------------------------------

enum SanctionStatus {
  ACTIVA
  CUMPLIDA
}

model Sanction {
  id            String         @id @default(cuid())
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  team          Team           @relation(fields: [teamId], references: [id])
  teamId        String
  reason        String
  matchesCount  Int
  startDate     DateTime
  endDate       DateTime?
  status        SanctionStatus @default(ACTIVA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("sanctions")
}

// Ajuste manual de puntos en la tabla de posiciones (Art. 9 abandono de
// partido, Art. 11 "Regla Milán-Cherembo" por spam, u otras decisiones de
// la organización). Se suma (puede ser negativo) al total de puntos del
// equipo en computeStandings().
model PointAdjustment {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  points    Int
  reason    String
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId   String?
  createdAt DateTime @default(now())

  @@index([teamId])
  @@map("point_adjustments")
}

// ---------------------------------------------------------------------------
// Configuración del torneo y reglamento
// ---------------------------------------------------------------------------

model TournamentSettings {
  id                String   @id @default("settings")
  tournamentName    String   @default("Liga AEFPY")
  standingsCriteria String   @default("PTS,DG,GF")
  rulesContent      String   @default("")
  rulesPdfUrl       String?
  updatedAt         DateTime @updatedAt

  @@map("tournament_settings")
}

// ---------------------------------------------------------------------------
// Actividad reciente (para el dashboard)
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id @default(cuid())
  message   String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())

  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Cuentas públicas (hinchas) y predicciones de partidos
// ---------------------------------------------------------------------------
// Sistema de cuentas totalmente separado del panel administrativo: cualquier
// visitante puede registrarse en el sitio público para votar quién cree que
// gana cada partido, antes de que se juegue. No tiene ningún permiso sobre
// el panel de administración.

model FanUser {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  predictions Prediction[]

  @@map("fan_users")
}

enum PredictionChoice {
  LOCAL
  EMPATE
  VISITANTE
}

// Una predicción pertenece a un hincha (fanUser) O a un usuario de staff con
// rol DELEGADO (staffUser) — nunca a ambos. Se modela con dos relaciones
// opcionales en vez de una sola columna genérica para conservar la
// integridad referencial (FK real) hacia cada tabla de cuentas.
model Prediction {
  id          String            @id @default(cuid())
  fanUser     FanUser?          @relation(fields: [fanUserId], references: [id], onDelete: Cascade)
  fanUserId   String?
  staffUser   User?             @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  staffUserId String?
  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  choice      PredictionChoice
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([fanUserId, matchId])
  @@unique([staffUserId, matchId])
  @@index([matchId])
  @@map("predictions")
}

// Videos destacados (goles, resúmenes, transmisiones en vivo) enlazados
// desde YouTube, Twitch u otra plataforma — la liga sólo carga el link y el
// título, nunca sube archivos de video. El "visor" (embed) se resuelve en
// tiempo de render a partir de la URL, ver src/lib/video.ts.
model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  // Elegido a mano desde /admin/videos para aparecer en el inicio — el
  // inicio nunca muestra los últimos automáticamente, sólo los destacados.
  // El primero de la lista (más reciente) se muestra grande arriba de
  // todo; el resto, en una franja más chica más abajo — ver HomePage.
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("videos")
}
